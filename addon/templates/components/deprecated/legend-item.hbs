<div class="grid-x">
  <div class="cell auto">
    <Deprecated::LegendIcon @icon={{this.item.icon}} />
    {{this.item.label}}
  </div>
  <div class="cell shrink">
    {{#if this.item.tooltip}}
      <Deprecated::IconTooltip @tip={{this.item.tooltip}} @side="left" @fixedWidth={{true}} />
    {{/if}}
  </div>
</div>
